# =============================================================================
# Agentic Code Reviewers — referência de variáveis de ambiente
# =============================================================================
#
# Uso:
#   cp .env.example .env
#   # Edite .env com seus valores; nunca commite secrets.
#
# Nomenclatura:
#   • Runner TypeScript (src/env.ts): prefixo AGENTIC_CODE_REVIEWERS_*
#   • Credenciais LLM sem prefixo: CURSOR_API_KEY, OPENCODE_API_KEY
#   • GitHub fallback (token): GITHUB_TOKEN ou GH_TOKEN se AGENTIC_CODE_REVIEWERS_GITHUB_TOKEN omitido
#
# Precedência (quando aplicável):
#   CLI (--engine, --model, --score-min, …) > variável de ambiente > default
#
# Fora do env.ts (documentadas aqui por conveniência):
#   • run.sh: AGENTIC_CODE_REVIEWERS_REPO_URL, _RELEASE_BRANCH, _LOCAL, _USE_TSX
#   • GitHub repo variable: AGENTIC_CODE_REVIEWERS_EXECUTION_MODE (parallel | sequential)
#
# Legado CURSOR_REVIEWER_* — NÃO é mais lido. Migre para AGENTIC_CODE_REVIEWERS_*.
# =============================================================================


# =============================================================================
# INÍCIO RÁPIDO — cursor-sdk local (dry-run)
# =============================================================================
#
# Mínimo para testar localmente:
#
#   CURSOR_API_KEY=cursor_sua_chave_aqui
#   AGENTIC_CODE_REVIEWERS_ENGINE=cursor-sdk
#   AGENTIC_CODE_REVIEWERS_MODEL=composer-2.5
#
#   npm run review -- --dry-run
# =============================================================================


# =============================================================================
# 1. CREDENCIAIS
# =============================================================================

# --- LLM (escolha conforme AGENTIC_CODE_REVIEWERS_ENGINE) ---

# Cursor SDK — obrigatória com engine cursor-sdk (default).
# Onde obter: https://cursor.com/settings (API Keys)
# Exemplo:
CURSOR_API_KEY=cursor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenCode Go — usada por run.sh/CI para gravar ~/.local/share/opencode/auth.json.
# NÃO é lida por src/env.ts; necessária apenas com engine opencode em CI.
# Exemplo:
# OPENCODE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Plataforma (publicar/resolver threads na PR) ---

# Azure DevOps — PAT local (Build Service usa SYSTEM_ACCESSTOKEN em pipeline).
# Escopos: Code (read) + Pull Request Threads (read & write).
# Exemplo:
# AGENTIC_CODE_REVIEWERS_AZURE_DEVOPS_PAT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub — PAT recomendado para resolveReviewThread e auto-fix/solve-pr.
# Fine-grained: Pull requests Read and write. Classic: escopo repo.
# Em CI, github.token publica comentários mas frequentemente NÃO resolve threads.
# Exemplo:
# AGENTIC_CODE_REVIEWERS_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fallback se AGENTIC_CODE_REVIEWERS_GITHUB_TOKEN omitido (local / Actions):
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# =============================================================================
# 2. ENGINE E MODELO
# =============================================================================

# Engine de execução LLM.
# Valores: cursor-sdk | opencode
# Default: cursor-sdk
# CLI equivalente: --engine opencode
# AGENTIC_CODE_REVIEWERS_ENGINE=cursor-sdk

# Modelo LLM (formato depende da engine).
#   cursor-sdk → ID Cursor (ex.: composer-2.5, claude-4.6-sonnet-medium-thinking)
#   opencode   → provider/model (ex.: opencode-go/deepseek-v4-flash)
# Default: composer-2.5 (cursor-sdk) ou opencode-go/deepseek-v4-flash (opencode)
# CLI equivalente: --model
# AGENTIC_CODE_REVIEWERS_MODEL=composer-2.5

# Variante do modelo / reasoning effort (opencode, ex.: none, low, medium, high, max).
# CLI equivalente: --variant
# AGENTIC_CODE_REVIEWERS_VARIANT=high


# =============================================================================
# 3. CONTEXTO DA PR / REPOSITÓRIO (override local)
# =============================================================================
# Em CI, org/project/repo/pr-id são inferidos de SYSTEM_* ou GITHUB_*.
# Use estas variáveis para dry-run local contra uma PR específica.

# ID numérico da Pull Request.
# Exemplo: AGENTIC_CODE_REVIEWERS_PR_ID=42

# Azure DevOps — organização, projeto e repositório.
# Exemplo:
# AGENTIC_CODE_REVIEWERS_ADO_ORG=minha-org
# AGENTIC_CODE_REVIEWERS_ADO_PROJECT=MeuProjeto
# AGENTIC_CODE_REVIEWERS_ADO_REPO=meu-repo

# Raiz do repositório alvo (default: auto-detect).
# Exemplo: AGENTIC_CODE_REVIEWERS_REPO_ROOT=/caminho/para/repo-alvo

# Branch de comparação do diff (target). Source = branch da PR / HEAD local.
# Default: refs/heads/master
# Exemplo: AGENTIC_CODE_REVIEWERS_TARGET_BRANCH=refs/heads/main

# Tag do bot nos comentários — usada para filtrar threads e assinar replies.
# Default: [Cursor Reviewer]
# Exemplo: AGENTIC_CODE_REVIEWERS_BOT_TAG=[Cursor Reviewer · OpenCode]


# =============================================================================
# 4. OPENCODE (somente quando AGENTIC_CODE_REVIEWERS_ENGINE=opencode)
# =============================================================================
# Servidor embutido por padrão (opencode serve). Omita OPENCODE_URL para embutido.

# URL de servidor OpenCode EXTERNO (opcional). Vazio = embutido.
# Exemplo: AGENTIC_CODE_REVIEWERS_OPENCODE_URL=http://127.0.0.1:43147

# Host/porta do servidor embutido.
# Default hostname: 127.0.0.1 | porta: 4096 (0 = porta efêmera)
# AGENTIC_CODE_REVIEWERS_OPENCODE_HOSTNAME=127.0.0.1
# AGENTIC_CODE_REVIEWERS_OPENCODE_PORT=4096

# Agente read-only na sessão OpenCode.
# Default: explore
# AGENTIC_CODE_REVIEWERS_OPENCODE_AGENT=explore

# Caminho do CLI opencode (default: PATH ou ~/.opencode/bin).
# AGENTIC_CODE_REVIEWERS_OPENCODE_BIN=/home/user/.opencode/bin/opencode

# Mata processo ocupando a porta preferida antes de subir o servidor.
# Default: false
# AGENTIC_CODE_REVIEWERS_OPENCODE_KILL_PORT=false

# Pipe stdout/stderr do opencode serve para o log do runner.
# Default: true
# AGENTIC_CODE_REVIEWERS_OPENCODE_SERVER_LOG=true

# Nível de log do servidor embutido.
# Default: DEBUG
# AGENTIC_CODE_REVIEWERS_OPENCODE_LOG_LEVEL=DEBUG

# Stream SSE de raciocínio ([reasoning]) durante o prompt.
# Default: true
# AGENTIC_CODE_REVIEWERS_OPENCODE_STREAM_REASONING=true


# =============================================================================
# 5. COMPORTAMENTO DO REVIEW
# =============================================================================

# Simula execução sem publicar threads na PR (exit 0 salvo erro fatal).
# Preferir flag CLI: --dry-run
# Default: false
# AGENTIC_CODE_REVIEWERS_DRY_RUN=true

# Logs detalhados e stream [assistant] no OpenCode.
# Default: true | Desativar: --quiet ou false
# AGENTIC_CODE_REVIEWERS_VERBOSE=true

# Timeout da sessão do agente em milissegundos.
# Default: 600000 (10 min)
# AGENTIC_CODE_REVIEWERS_TIMEOUT_MS=600000

# Sandbox read-only do cursor-sdk (bloqueia escrita no repo alvo).
# Default: true
# AGENTIC_CODE_REVIEWERS_SANDBOX=true

# Inclui alterações não commitadas (staged/unstaged/untracked vs HEAD) no diff.
# Default: false | CLI: --include-uncommitted
# AGENTIC_CODE_REVIEWERS_INCLUDE_UNCOMMITTED=false

# Modo validação E2E local (fixtures SEED-ISSUES.md). Ativa include-uncommitted.
# Default: false | CLI: --seed-test
# AGENTIC_CODE_REVIEWERS_SEED_TEST=false

# Inclui o próprio runner no diff (CI deste repositório). Mescla *.yml, *.yaml, *.sh.
# Default: false
# AGENTIC_CODE_REVIEWERS_REVIEW_SELF=false

# Cores ANSI no log do terminal.
# Default: true
# AGENTIC_CODE_REVIEWERS_PROMPT_COLOR=true

# Rodadas máximas review↔fix antes do escalonamento (só critical + handoff humano).
# Default: 5 | 0 = desabilita escalonamento
# AGENTIC_CODE_REVIEWERS_MAX_ROUNDS=5


# =============================================================================
# 6. PUBLICAÇÃO DE THREADS (score, gate, safe outputs)
# =============================================================================

# Score mínimo (inclusive) para publicar achado como thread na PR.
# Fluxo end-to-end: prompt → isPublishableReview → Safe Outputs (mesmo valor).
# Default: 6 | Range válido: 0–10
# Precedência: --score-min > esta variável > default 6
# Exemplo permissivo (CI self-review deste repo usa 1):
# AGENTIC_CODE_REVIEWERS_SCORE_MIN=6

# Gate determinístico pós-LLM (diff-line, protected paths, secrets, analysis).
# Default: true
# AGENTIC_CODE_REVIEWERS_SAFE_OUTPUTS=true

# Exige que lineNumber esteja em linha alterada no diff.
# Default: true
# AGENTIC_CODE_REVIEWERS_REQUIRE_DIFF_LINE=true

# Limite de caracteres por comment/analysis.
# Default: 8000
# AGENTIC_CODE_REVIEWERS_MAX_COMMENT_CHARS=8000

# Globs extras de paths protegidos (CSV). Bloqueia reviews que referenciem CI/locks.
# Built-in inclui .github/workflows/**, package-lock.json, .env*, etc.
# Exemplo: AGENTIC_CODE_REVIEWERS_PROTECTED_PATTERNS=**/secrets/**,**/credentials.json


# =============================================================================
# 7. AUTO-FIX E CORREÇÃO COOPERATIVA
# =============================================================================
# Modo distinto do review read-only. Requer PR ID + token com escrita.
# Gate: commit local → build → resolver threads → push (ver skills/COOPERATIVE_FIX.md).
# CLI equivalente: --auto-fix

# Ativa fluxo auto-fix (subagentes + commit + resolução de threads).
# Default: false
# AGENTIC_CODE_REVIEWERS_AUTO_FIX=false

# Comando de build após commit local no auto-fix (antes de resolver threads e push).
# Default: `npm test` se scripts.test; senão `npm run build` se scripts.build; omitido = sem validação.
# Desabilitar explicitamente: AGENTIC_CODE_REVIEWERS_AUTO_FIX_BUILD_COMMAND=
# AGENTIC_CODE_REVIEWERS_AUTO_FIX_BUILD_COMMAND=dotnet build

# Skill IDE equivalente (sem esta variável): /solve-pr
# Usa o mesmo contrato cooperativo; token via AGENTIC_CODE_REVIEWERS_GITHUB_TOKEN.


# =============================================================================
# 8. STACK E PADRÕES DE ARQUIVO
# =============================================================================

# Stack tecnológica do review (recomendações em skills/stacks/).
# Valores: ABP/Angular | PHP/Laravel | Next.js/React | TypeScript | Custom
# Default: autodetect (fallback ABP/Angular)
# CLI: --stack=PHP/Laravel
# AGENTIC_CODE_REVIEWERS_STACK=TypeScript

# Obrigatório quando STACK=Custom — caminho do arquivo ou string inline.
# CLI: --custom-prompt=./meu-prompt.md
# AGENTIC_CODE_REVIEWERS_CUSTOM_PROMPT=./prompts/review-custom.md

# Globs de inclusão no diff (CSV). Sobrescreve padrão da stack.
# Exemplo Custom: **/*.py,**/*.go
# AGENTIC_CODE_REVIEWERS_INCLUDE_PATTERNS=**/*.ts,**/*.tsx

# Globs extras de exclusão (CSV), além dos excludes base da stack.
# AGENTIC_CODE_REVIEWERS_EXTRA_EXCLUDE_PATTERNS=**/generated/**,**/*.min.js


# =============================================================================
# 9. PARALELISMO, META-REVIEWER E MCP
# =============================================================================

# Número de agentes paralelos in-process (chunks de arquivos).
# Default: 1 (sequencial)
# AGENTIC_CODE_REVIEWERS_PARALLEL_CHUNKS=1

# Segunda passagem LLM para filtrar/deduplicar após merge de chunks paralelos.
# Default: false
# AGENTIC_CODE_REVIEWERS_META_REVIEWER=false

# Injeta ferramentas MCP read-only no prompt do agente.
# Default: false
# AGENTIC_CODE_REVIEWERS_MCP_ENABLED=false

# Lista de tools MCP (CSV). Default interno quando MCP habilitado.
# AGENTIC_CODE_REVIEWERS_MCP_TOOLS=get_diff,get_changed_files,read_file,grep

# Comandos opcionais executados via MCP para contexto extra.
# AGENTIC_CODE_REVIEWERS_MCP_LINT_CMD=npm run lint
# AGENTIC_CODE_REVIEWERS_MCP_TEST_CMD=npm test

# Módulos de prompt skills/tasks/* (CSV). Ex.: security,performance
# AGENTIC_CODE_REVIEWERS_PROMPT_MODULES=security,performance


# =============================================================================
# 10. RUN.SH APENAS (shell — não passam por src/env.ts)
# =============================================================================
# Usadas ao executar bash run.sh (modo remoto ou --local).

# URL git do repositório do runner (modo remoto via curl | bash).
# Default: https://github.com/jpolvora/agentic-code-reviewers.git
# AGENTIC_CODE_REVIEWERS_REPO_URL=https://github.com/jpolvora/agentic-code-reviewers.git

# Branch/tag dos artefatos compilados (dist/) no modo remoto.
# Default: release
# AGENTIC_CODE_REVIEWERS_RELEASE_BRANCH=release

# Modo local: usa checkout atual + tsx (sem clone release).
# Default: false | Equivalente: bash run.sh --local
# AGENTIC_CODE_REVIEWERS_LOCAL=1

# Força npx tsx src/index.ts em --local (default quando src/index.ts existe).
# AGENTIC_CODE_REVIEWERS_USE_TSX=true


# =============================================================================
# 11. CI GITHUB APENAS (variável de repositório — não passa por env.ts)
# =============================================================================
# Settings → Secrets and variables → Actions → Variables

# Modo da matrix em code-review.yml para PRs automáticos.
# Valores: parallel | sequential
# Default do workflow: parallel (ou input em workflow_dispatch)
# AGENTIC_CODE_REVIEWERS_EXECUTION_MODE=parallel
