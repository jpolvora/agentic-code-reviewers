{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "step-artifact.schema.json",
  "title": "Step artifact metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["step", "slug", "workflowId", "status", "startedAt", "endedAt", "acRefs"],
  "properties": {
    "step": { "type": "integer", "minimum": 0, "maximum": 9 },
    "slug": { "type": "string", "minLength": 1 },
    "workflowId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "completed", "failed", "skipped", "blocked"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "acRefs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^AC[1-9][0-9]*$" },
      "uniqueItems": true
    },
    "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
