{
  "$schema": "./config.schema.json",
  "_comment": "Fresh install seeds this file as config.json (gitignored — never commit). Fill via ws-configure-project. toolsFile points to the tool vocabulary all agents use.",
  "toolsFile": "tools.md",

  "pathTokens": {
    "_comment": "Fixed install layout (not relocatable). Expand brace tokens before Read/Grep/Shell. Full contract: tools.md § Path tokens. plansDir/reviewsDir still resolve from plans.dir / reviews.dir.",
    "skillsRoot": ".agents/skills",
    "sharedDir": ".agents/skills/ws-shared"
  },

  "project": {
    "name": "<PROJECT_NAME>",
    "org": "<GITHUB_ORG>",
    "repoUrl": "https://github.com/<ORG>/<REPO>",
    "baseBranch": "master",
    "workingBranch": "develop",
    "gitRemote": "origin"
  },

  "stack": {
    "id": "<STACK_ID e.g. dotnet-react, node-nextjs, python-django>",
    "description": "<Brief stack description>",

    "backend": {
      "framework": "<e.g. .NET 10, Node 22, Python 3.12>",
      "language": "<e.g. C#, TypeScript, Python>",
      "solutionFile": "<e.g. MyApp.slnx, package.json, pyproject.toml>",
      "srcDir": "src",
      "layers": [
        { "name": "<layer>", "path": "<path>", "role": "<responsibilities>" }
      ],
      "testProject": "<e.g. tests/MyApp.Tests/MyApp.Tests.csproj>",
      "apiHost": "http://localhost:5000",
      "apiPort": 5000
    },

    "frontend": {
      "framework": "<e.g. React 19 + Vite, Next.js 14, Vue 3>",
      "language": "<e.g. TypeScript, JavaScript>",
      "sourceDir": "<e.g. web/src, src/app>",
      "buildDir": "<e.g. web>",
      "devHost": "http://localhost:3000",
      "devPort": 3000,
      "i18n": {
        "framework": "<e.g. react-i18next, next-intl, none>",
        "localesDir": "<path to locale files>",
        "locales": ["<e.g. en-US>"]
      }
    },

    "database": {
      "type": "<e.g. PostgreSQL, SQLite, MongoDB>",
      "orm": "<e.g. Entity Framework Core, Prisma, Drizzle>",
      "migrationsProject": "<path>",
      "startupProject": "<path>",
      "seedScript": "<e.g. scripts/seed.sh>"
    },

    "orchestration": {
      "devCommand": "<e.g. npm run dev>",
      "startCommand": "<e.g. npm start>",
      "stopCommand": "<e.g. npm stop>",
      "composeCommand": "<e.g. docker compose up --build>"
    }
  },

  "domain": {
    "model": "<Brief domain model description>",
    "tenancyField": "<e.g. CompanyId, TenantId>",
    "platformPrefix": "<e.g. /api/v1/platform>",
    "glossaryFile": "",
    "designTokens": "",
    "architectureSpec": "<path to architecture spec doc>"
  },

  "providers": {
    "_comment": "active = work-item/spec source (github | azure-devops | local). scm = PR/thread host (github | azure-devops only; never local). Hybrid example: active=local + scm=github (local specs, GitHub PRs). If scm omitted: when active is github|azure-devops → scm=active; when active=local → infer from project.repoUrl host (github.com → github; dev.azure.com|visualstudio.com → azure-devops) or STOP and set scm explicitly. LEGACY: omit this entire providers block to infer active from issueTrackers.*.enabled (GitHub if enabled, else Azure DevOps, else local).",
    "active": "github",
    "scm": "github"
  },

  "issueTrackers": {
    "github": {
      "enabled": true,
      "owner": "<GITHUB_ORG>",
      "repo": "<GITHUB_REPO>",
      "cli": "gh",
      "issueToSpecScript": ".agents/skills/ws-github-provider/scripts/github-issue-to-spec.py"
    },
    "azureDevOps": {
      "enabled": false,
      "_comment": "Set enabled: true and fill org/project. Put token in ADO_PAT (or AZURE_DEVOPS_PAT) — never commit it.",
      "org": "",
      "project": "",
      "patEnvVar": "ADO_PAT",
      "apiBase": "https://dev.azure.com",
      "workItemToSpecScript": ".agents/skills/ws-azure-devops-provider/scripts/ado-workitem-to-spec.py"
    }
  },

  "verification": {
    "backendBuild": "<e.g. dotnet build MyApp.slnx, npm run build, pytest>",
    "backendTest": "<e.g. dotnet test tests/MyApp.Tests, npm test, pytest>",
    "backendFormat": "<e.g. dotnet format MyApp.slnx --verify-no-changes, npm run lint>",
    "frontendBuild": "<e.g. cd web && npm run build>",
    "frontendTest": "<e.g. cd web && npm test>",
    "migrationsAdd": "<e.g. dotnet ef migrations add {Name} -p src/Infrastructure -s src/Api>",
    "migrationsApply": "<e.g. dotnet ef database update -p src/Infrastructure -s src/Api>",
    "mutationTest": "",
    "_comment_mutationTest": "Optional mutation runner (e.g. npx stryker run, mvn org.pitest:pitest-maven:mutationCoverage). Empty = skip mutation substep in ws-testing Step 7.",
    "mutationThreshold": 80,
    "_comment_mutationThreshold": "Minimum mutation score percent (killed/(killed+survived)*100). Used when mutationTest is set and skipMutationTesting is false.",
    "testGlobs": ["test/**/*.js", "tests/**/*", "**/*.test.*", "**/*.spec.*"],
    "_comment_testGlobs": "Machine test-surface probe patterns. Step 7 auto-skip requires no non-empty test alias and no matching file."
  },

  "dagThresholds": {
    "_comment": "If ALL criteria are within limits, execMode is sequential (skip DAG).",
    "maxImplementationSteps": 3,
    "maxExpectedFiles": 6,
    "maxLayers": 2
  },

  "defaults": {
    "autoMode": false,
    "dryRun": false,
    "skipTesting": false,
    "skipMutationTesting": true,
    "_comment_skipMutationTesting": "When true (default), skip Step 7 mutation substep even if verification.mutationTest is set. Opt in by setting false and providing mutationTest.",
    "skipTests": false,
    "fullMode": false,
    "scoreAndRefine": false,
    "_comment_scoreAndRefine": "Optional extra polish when Step 5 score is already >= 9. Score < 9 always runs scoreAndRefine until >= 9 (max 3 rounds, then Pause).",
    "autoload": false,
    "_comment_autoload": "When true, consumer intends repo-root AGENTS.md to autoload Always-applied skills from {sharedDir}/autoload.md. Omitted/missing/false → effective false; harness fails closed only when true.",
    "enableAuditing": false,
    "_comment_enableAuditing": "When true, ws-spec-to-pr* orch runs under ws-audit runtime observer; writes {us-dir}/audit-*.log.md; logs anomalies/performance/correctness/disposable scripts; end-of-run may propose upstream GitHub issues or reusable tooling. Default false.",
    "enableDag": false,
    "_comment_enableDag": "When true, break execution plan into multiple parallel tasks. When false (default), execute tasks sequentially one by one in serial order.",
    "contextBudget": 32000,
    "_comment_contextBudget": "Maximum UTF-8 bytes in one complete standard subagent dispatch; fixed contract preamble remains capped at 18000 and MEMORY at 4000.",
    "parallelVerifyReview": false,
    "_comment_parallelVerifyReview": "When true, standard Steps 5 and 6 may run concurrently as read-only reviewers after an immutable product commit; default false.",
    "gateGranularity": "step",
    "_comment_gateGranularity": "step prompts at every boundary; phase uses at most five blocking gates in a normal standard run without weakening hard stops.",
    "convergence": {
      "initialDelaySec": 0,
      "minPollSec": 30,
      "maxPollSec": 300,
      "backoff": 1.5,
      "maxIterations": 20
    },
    "patternsBackend": true,
    "patternsFrontend": true,
    "_comment_patterns": "When true, ws-patterns-backend and ws-patterns-frontend are active for consulting backend.md and frontend.md during development.",
    "_comment_deliveryCommitArtifacts": "Step 8 delivery commit includes under {us-dir}. Defaults: refined plan on; delivery result off (behavior change vs legacy always plan+result); opt-ins false. Omitted object/keys at read time merge to these AC1 defaults — never silently revert to always staging plan+result.",
    "deliveryCommitArtifacts": {
      "includeRefinedPlan": true,
      "includeDeliveryResult": false,
      "includeSpec": false,
      "includeCheckReport": false,
      "includeCodeReview": false,
      "includeTestingReport": false
    },
    "_comment_models": "Optional portable model identifiers for subagents. Fallback to the active session model if empty or unavailable. testingModel is the test executor for standard Step 7; empty/omitted uses executionModel. reviewerModel covers standard Steps 5-6 only.",
    "plannerModel": "",
    "executionModel": "",
    "reviewerModel": "",
    "testingModel": ""
  },

  "plans": {
    "dir": ".agents/plans",
    "_comment_plansDir": "Resolve skill token {plansDir} from plans.dir (there is no separate plansDir key).",
    "_comment_specsDir": "Human-facing local specs dir. Skill token {specsDir} ← plans.specsDir (default .agents/specs). Prefer existing repo-root specs/ when already present. ws-write-spec writes here only; workflow step-00 copies under {plansDir}/{slug}/ come from providers or ws-local-spec-provider register.",
    "specsDir": ".agents/specs",
    "diagnosticsDir": ".agents/plans/diagnostics",
    "worktreesDir": ".agents/plans/{slug}/worktrees",
    "useWorktrees": false
  },

  "reviews": {
    "_comment": "Optional local review artifact root (fix-pr / ws-goal-fix-pr round reports).",
    "dir": ".agents/codereviews"
  },

  "preview": {
    "_comment": "Optional ws-preview dry-run overrides. preview.backend is not required for v1 (defaults to cursor-reviewer).",
    "stack": "",
    "backend": "cursor-reviewer"
  },

  "rules": {
    "_comment": "Guardrails paths. Resolve per ws-shared/AGENTS.md External dependencies (first match). seniorDeveloper = Code review proof checklist source (default packaged ws-senior-developer); set \"\" to disable or point at another guardrail; karpathyGuidelines = surgical-change skill; stackFile = stack companion; changelogFile = append-only history (default under ws-shared/); other keys optional consumer rule paths — leave empty when unused.",
    "harness": ".agents/skills/ws-shared/AGENTS.md",
    "seniorDeveloper": ".agents/skills/ws-senior-developer/SKILL.md",
    "karpathyGuidelines": ".agents/skills/ws-karpathy-guidelines/SKILL.md",
    "viewPatterns": "",
    "efMigrations": "",
    "stackFile": ".agents/skills/ws-shared/STACK.md",
    "changelogFile": ".agents/skills/ws-shared/CHANGELOG.md"
  },

  "invariants": {
    "entitiesAreClassNotRecord": true,
    "migrationsCliOnly": true,
    "tenancyViaGlobalQueryFilters": true,
    "efOnlyInInfrastructure": true,
    "noInlineHandWrittenMigrations": true,
    "commitPlanFilesOnlyAtStep8": true,
    "skipQualityGates": false
  },

  "fable": {
    "_comment": "Opt-in integration for fable-* skills within ws-spec-to-pr / ws-spec-to-pr-lite workflows. Master toggle must be true to enable automatic calls.",
    "enabled": true,
    "autoAudit": true,
    "autoDetectDomain": true,
    "auditVerdictsBlockShip": "refuted"
  }
}
