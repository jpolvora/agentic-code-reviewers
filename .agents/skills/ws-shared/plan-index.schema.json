{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan-index.schema.json",
  "title": "Refined plan index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "ordering", "sections", "acceptanceCriteria"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "lines"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 1 },
        "lines": { "type": "integer", "minimum": 1 }
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptanceCriteria", "expectedFiles", "expectedTestNames", "sections", "taskIds"],
      "properties": {
        "acceptanceCriteria": { "type": "string" },
        "expectedFiles": { "type": "string" },
        "expectedTestNames": { "type": "string" },
        "sections": { "type": "string" },
        "taskIds": { "type": "string" }
      }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": { "$ref": "#/$defs/ac" }
    }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/)(?!.*\\\\).+" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "acId": { "type": "string", "pattern": "^AC[1-9][0-9]*$" },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "level", "byteStart", "byteEnd", "lineStart", "lineEnd", "sha256", "acRefs", "taskIds", "expectedFiles", "expectedTestNames"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "level": { "type": "integer", "minimum": 2, "maximum": 4 },
        "byteStart": { "type": "integer", "minimum": 0 },
        "byteEnd": { "type": "integer", "minimum": 1 },
        "lineStart": { "type": "integer", "minimum": 1 },
        "lineEnd": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "acRefs": { "type": "array", "items": { "$ref": "#/$defs/acId" }, "uniqueItems": true },
        "taskIds": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]{2}$" }, "uniqueItems": true },
        "expectedFiles": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
        "expectedTestNames": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "ac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "planSectionIds", "taskIds", "expectedFiles", "expectedTestNames"],
      "properties": {
        "id": { "$ref": "#/$defs/acId" },
        "text": { "type": "string", "minLength": 1 },
        "planSectionIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "taskIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "expectedFiles": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
        "expectedTestNames": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
