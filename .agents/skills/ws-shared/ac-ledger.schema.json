{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ac-ledger.schema.json",
  "title": "Acceptance criteria evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "workflowId", "slug", "specPath", "planIndexPath", "declaredGaps", "aliasResults", "testingSkip", "acceptanceCriteria", "scoreState"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "workflowId": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "specPath": { "$ref": "#/$defs/path" },
    "planIndexPath": { "type": ["string", "null"] },
    "declaredGaps": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "aliasResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "commandHash", "startedAt", "endedAt", "exitCode"],
        "properties": {
          "alias": { "type": "string" },
          "commandHash": { "$ref": "#/$defs/hash" },
          "startedAt": { "type": ["string", "null"] },
          "endedAt": { "type": ["string", "null"] },
          "exitCode": { "type": "integer" }
        }
      }
    },
    "testingSkip": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["reason", "evidence", "sha256"],
      "properties": {
        "reason": { "enum": ["no-test-surface", "testing-disabled"] },
        "evidence": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": { "$ref": "#/$defs/ac" },
      "minItems": 1
    },
    "scoreState": {
      "type": ["object", "null"]
    }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/)(?!.*\\\\).+" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "status", "evidence", "tasks", "planSections", "files", "commits", "tests", "verdicts", "findings", "sabotage", "linkEventIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^AC[1-9][0-9]*$" },
        "text": { "type": "string", "minLength": 1 },
        "status": { "enum": ["Pending", "Implemented", "ImplementedDifferently", "NotImplemented"] },
        "evidence": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "tasks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "planSections": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "lineStart", "lineEnd", "sha256"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "lineStart": { "type": "integer", "minimum": 1 },
              "lineEnd": { "type": "integer", "minimum": 1 },
              "sha256": { "$ref": "#/$defs/hash" }
            }
          }
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha", "step"],
            "properties": {
              "sha": { "type": "string", "minLength": 7 },
              "step": { "type": "integer", "minimum": 0, "maximum": 9 }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sourceFile", "phase"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "sourceFile": { "$ref": "#/$defs/path" },
              "phase": { "enum": ["planned", "observed"] },
              "alias": { "type": ["string", "null"] },
              "exitCode": { "type": ["integer", "null"] },
              "timestamp": { "type": "string" }
            }
          }
        },
        "verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["verdict", "evidence"],
            "properties": {
              "verdict": { "type": "string", "minLength": 1 },
              "evidence": { "type": "string", "minLength": 1 },
              "timestamp": { "type": "string" }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity", "state", "evidence"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "severity": { "enum": ["Critical", "Warning", "Suggestion"] },
              "state": { "enum": ["open", "closed"] },
              "evidence": { "type": "string", "minLength": 1 },
              "round": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "sabotage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "status", "exitCode"],
          "properties": {
            "required": { "type": "boolean" },
            "status": { "enum": ["not-required", "passed", "failed"] },
            "exitCode": { "type": ["integer", "null"] }
          }
        },
        "linkEventIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
